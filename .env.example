# Environment mode: "production" or "development"
ENV=production

# Default model to use (must exist in providers.json).
DEFAULT_MODEL=gemma4:latest

# Mandatory Administrative Secret Key (Required in Production, min 16 chars)
ADMIN_SECRET_KEY=replace_with_strong_random_admin_secret_key_2026

# Trusted CORS origins (comma-separated domains)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Provider API Keys
GEMINI_API_KEY=your_gemini_api_key_here

